    "## Paso 6 — Pre-trim del video (lógica del app.py)\n",
    "\n",
    "Recorta el video con `ffmpeg` ANTES del bloque GPU para que DWPose solo procese los frames necesarios.\n",
    "Réplica exacta de `trim_video_to_budget()` del `app.py`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-09",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tempfile, subprocess, logging\n",
    "\n",
    "logger = logging.getLogger(__name__)\n",
    "\n",
    "\n",
    "def trim_video_to_budget(video_path: str, max_output_frames: int, sample_stride: int) -> str:\n",
    "    \"\"\"Réplica exacta de trim_video_to_budget() del app.py.\n",
    "    Recorta el video con ffmpeg para que DWPose solo vea los frames necesarios.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        import decord\n",
    "        vr = decord.VideoReader(video_path)\n",
    "        total = len(vr)\n",
    "        max_raw = (max_output_frames + 1) * sample_stride\n",
    "        if total <= max_raw:\n",
    "            logger.info(f'Video {total} frames <= budget {max_raw}, sin recorte.')\n",
    "            return video_path\n",
    "        fps = vr.get_avg_fps() or 30.0\n",
    "        duration = max_raw / fps\n",
    "        out_path = tempfile.mktemp(suffix='.mp4')\n",
    "        subprocess.run(\n",
    "            ['ffmpeg', '-y', '-i', video_path,\n",
    "             '-t', f'{duration:.3f}',\n",
    "             '-c:v', 'libx264', '-preset', 'fast', '-crf', '18',\n",
    "             '-an', out_path],\n",
    "            check=True, capture_output=True,\n",
    "        )\n",
    "        logger.info(f'Pre-trim: {total} -> {max_raw} frames raw ({duration:.1f}s)')\n",
    "        return out_path\n",
    "    except Exception as e:\n",
    "        logger.warning(f'Video pre-trim falló ({e}), usando original.')\n",
    "        return video_path\n",
    "\n",
    "\n",
    "# Aplicar pre-trim antes de la inferencia (igual que en generate() del app.py)\n",
    "ref_video_trimmed = trim_video_to_budget(ref_video_path, MAX_OUTPUT_FRAMES, int(SAMPLE_STRIDE))\n",
    "print(f'Video de entrada para inferencia: {ref_video_trimmed}')"
   ]
  },
